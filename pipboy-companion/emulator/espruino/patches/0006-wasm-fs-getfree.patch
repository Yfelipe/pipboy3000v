diff --git a/libs/filesystem/jswrap_fs.c b/libs/filesystem/jswrap_fs.c
index d4a2e054..8ea2aeba 100755
--- a/libs/filesystem/jswrap_fs.c
+++ b/libs/filesystem/jswrap_fs.c
@@ -15,6 +15,9 @@
  */
 
 #include "jswrap_fs.h"
+#ifdef WASM
+#include "wasm_host.h"
+#endif
 #include "jswrap_file.h"
 #include "jsutils.h"
 #include "jsvar.h"
@@ -431,6 +434,19 @@ JsVar *jswrap_fs_getfree(JsVar *path) {
       return obj;
     }
   }
+#elif defined(WASM)
+  // the emulated SD card is the host's: it says how big the card is and how much is in use
+  double totalBytes = 0, freeBytes = 0;
+  if (wasmHostFsSpace(&totalBytes, &freeBytes)) {
+    const int sectorSize = 512, clusterSize = 64;
+    JsVar *obj = jsvNewObject();
+    if (!obj) return 0;
+    jsvObjectSetIntChild(obj, "freeSectors", (JsVarInt)(freeBytes / sectorSize));
+    jsvObjectSetIntChild(obj, "totalSectors", (JsVarInt)(totalBytes / sectorSize));
+    jsvObjectSetIntChild(obj, "sectorSize", sectorSize);
+    jsvObjectSetIntChild(obj, "clusterSize", clusterSize);
+    return obj;
+  }
 #else
   // @TODO: Implement something for Linux...?
 #endif
